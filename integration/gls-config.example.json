{
  "$comment": "Example connector contract between golden-loan-services (admin) and golden-financial-website- (customer platform). Copy to deployment config; never commit real secrets. The public admin prototype and GitHub Pages sandbox are not a live shared database.",
  "platform": "Golden Financial Services",
  "currency": "MWK",
  "catalogue": {
    "version": "2026-11-06-five-products",
    "active": [
      { "id": "PL", "name": "Personal" },
      { "id": "BL", "name": "Business" },
      { "id": "SA", "name": "Salary Advance" },
      { "id": "AL", "name": "Agriculture" },
      { "id": "EL", "name": "Emergency" }
    ],
    "retiredForHistoricalRecordsOnly": ["ED", "ML", "AF", "GL", "MG"]
  },
  "customerBackend": {
    "baseUrl": "https://your-backend.example",
    "healthEndpoint": "/api/health",
    "configEndpoint": "/api/config",
    "integrationKeyHeader": "X-GFS-Integration-Key",
    "integrationKey": "SET_VIA_ENV_GFS_INTEGRATION_KEY",
    "endpoints": {
      "exportFeed": "GET /api/integration/export?since=ISO8601",
      "pushSettings": "POST /api/integration/settings",
      "pushDecision": "POST /api/integration/decision",
      "publicBlogList": "GET /api/blog/posts",
      "publicBlogDetail": "GET /api/blog/posts/:slug"
    },
    "publishedSettingsKeys": ["company", "products", "payment_methods", "branches", "theme", "rules", "blog_posts"]
  },
  "adminSystem": {
    "repo": "https://github.com/wwwmaryemmanuel01/golden-loan-services",
    "pagesUrl": "https://wwwmaryemmanuel01.github.io/golden-loan-services/",
    "note": "Public admin pages are a static prototype. Live synchronisation requires a deployed authenticated adapter and configured backend.",
    "modules": ["applications.html", "clients.html", "payments.html", "repayments.html", "statements.html", "settings.html", "website.html"]
  },
  "githubPagesSandbox": {
    "storageKey": "gfs_sandbox_v2",
    "blogSourceLabel": "device",
    "writesAdminLocalStorage": false,
    "note": "Device-local demonstration only. No shared database, real payments, external identity checks or admin localStorage bridge."
  },
  "sharedRules": {
    "affordabilityCap": 0.4,
    "latePenaltyPctPerMonth": 2,
    "graceDays": 3,
    "allocationOrder": ["penalties", "fees", "interest", "principal"],
    "interestMethod": "declining-balance, equal instalments (annuity)",
    "arrangementFee": "deducted at disbursement"
  },
  "referenceFormats": {
    "customer": "GF-nnnnnn",
    "application": "GLS-APP-nnnnnn",
    "loan": "LN-YYYY-nnnn",
    "transaction": "TXN-YYYYMMDD-XXXXXX",
    "receipt": "RCT-YYYYMMDD-XXXXXX",
    "disbursement": "DSB-YYYYMMDD-XXXXXX"
  },
  "paymentWebhooks": {
    "path": "/api/webhooks/{mpamba|airtel|bank|paychangu}",
    "signatureHeader": "X-GFS-Signature: sha256=HMAC_SHA256(rawBody, providerSecret)",
    "body": { "providerRef": "string", "amount": "number", "status": "success|failed", "reason": "optional" }
  }
}
